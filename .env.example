# Firebase (for JWT validation)
# Your Firebase project ID - find this in Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id

# Platform API (for token resolution)
# Base URL for agentbase.me platform
PLATFORM_URL=https://agentbase.me

# Platform Service Token
# Shared secret for authenticating with platform API
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_SERVICE_TOKEN=your-shared-secret-here

# Server Configuration
# Port for the MCP server to listen on
PORT=8080

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
